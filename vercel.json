      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ],
  "env": {
    "TURSO_DATABASE_URL": "libsql://reviactyl-andri.aws-ap-south-1.turso.io",
    "TURSO_AUTH_TOKEN": "YOUR_TURSO_AUTH_TOKEN", 
    "ADMIN_USERNAME": "YOUR_ADMIN_USERNAME",
    "ADMIN_PASSWORD": "YOUR_ADMIN_PASSWORD"
  }
}
